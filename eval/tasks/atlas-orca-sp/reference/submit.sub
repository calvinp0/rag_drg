# orca-5 on atlas (HTCondor); generated by rag-drg from servers.yaml.
# Submit: chmod u+x job.sh && condor_submit submit.sub
# The pool holds jobs running longer than 72:00:00 (vanilla in servers.yaml).
universe              = vanilla
executable            = job.sh
+JobName              = "H2O_sp"
log                   = job.log
output                = out.txt
error                 = err.txt
getenv                = True
environment           = "CONDOR_JOBID=$(Cluster).$(Process)"
should_transfer_files = NO
request_cpus          = 4
request_memory        = 4096MB
queue
