# Codex CLI: add to ~/.codex/config.toml (or run the equivalent
#   codex mcp add rag-drg -- "$(uv tool dir --bin)/rag-drg" serve
# ). Use an absolute path; `~` is not expanded. Either the `uv tool` command
# (e.g. /home/<you>/.local/bin/rag-drg) or the repo launcher /ABS/PATH/TO/rag_drg/bin/rag-drg
# works; both find the repo's rag_drg.yaml themselves.
[mcp_servers.rag-drg]
command = "/home/<you>/.local/bin/rag-drg"      # or /ABS/PATH/TO/rag_drg/bin/rag-drg
args = ["serve"]
# Only needed if the install is not .venv or a conda env named rag-drg / rag_drg:
# env = { RAG_DRG_BIN = "/home/<you>/miniforge3/envs/<env>/bin/rag-drg" }
# Loading the index can take a few seconds on first start; raise this if Codex times out.
startup_timeout_sec = 30

# Shared group server instead (streamable HTTP; needs a Codex version with HTTP MCP support -
# check `codex mcp add --help` for --url / --bearer-token-env-var):
# [mcp_servers.rag-drg]
# url = "http://<server>:8765/mcp"
# bearer_token_env_var = "RAG_DRG_TOKEN"
