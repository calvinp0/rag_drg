# systemd unit for the shared group server (MCP + REST over HTTP, token auth; see docs/auth.md).
#   sudo cp deploy/rag-drg.service /etc/systemd/system/ && edit paths/user/host name
#   sudo -u <service-user> /opt/rag_drg/.venv/bin/rag-drg tokens add <member>   # once per member
#   sudo systemctl daemon-reload && sudo systemctl enable --now rag-drg
# Members then run:
#   claude mcp add --transport http rag-drg http://<host>:8765/mcp --header "Authorization: Bearer $RAG_DRG_TOKEN"
# Tokens are added/revoked without a restart. Health check: curl http://<host>:8765/api/health
[Unit]
Description=rag-drg group knowledge base (MCP + REST over HTTP)
After=network.target

[Service]
Type=simple
User=<service-user>
WorkingDirectory=/opt/rag_drg
Environment=RAG_DRG_CONFIG=/opt/rag_drg/rag_drg.yaml
# Token hashes live in index/tokens.yaml by default (git-ignored). To keep them elsewhere, set
#   auth: {tokens_file: /etc/rag-drg/tokens.yaml}
# in rag_drg.yaml or conf.d/, readable and writable (last_used) by <service-user> only.
# Host names clients use in the URL (comma-separated): the MCP Host-header check allows these.
Environment=RAG_DRG_ALLOWED_HOSTS=<host>,<host>.<domain>
ExecStart=/opt/rag_drg/.venv/bin/rag-drg serve --transport http --host 0.0.0.0 --port 8765 --auth token
# Behind a TLS proxy (Caddy/nginx) on the same machine, bind to loopback instead:
#   ExecStart=... serve --transport http --host 127.0.0.1 --port 8765
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
